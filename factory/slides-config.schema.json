{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sayla local slideshow draft input",
  "type": "object",
  "required": ["client", "caption", "background_images", "hooks", "output_dir"],
  "properties": {
    "client": { "type": "string", "minLength": 1 },
    "caption": { "type": "string", "minLength": 1, "description": "Required social caption; written to caption.txt. No LLM is used." },
    "background_images": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Plain local paths relative to this JSON file. Resolved files must remain inside factory/. URLs, schemes, data URIs, network paths and traversal outside factory/ are rejected."
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "text": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" }, "description": "Each array element is an explicit text line; embedded newlines and control characters are rejected." },
          "hashtags": { "type": ["string", "array"] }
        }
      },
      "description": "Hooks remain in array order and one hook produces one slide."
    },
    "output_dir": { "type": "string", "minLength": 1, "description": "Relative to this JSON file; must resolve to a new direct child of factory/drafts/. Nested paths are rejected. factory/drafts must be a real directory, not a symlink, and its real path is verified before staging and rename. Existing output is never overwritten." },
    "font": {
      "type": "object",
      "properties": {
        "fontFamily": { "const": "DejaVu Sans" },
        "fontSize": { "type": "number", "minimum": 16, "maximum": 160, "default": 72 },
        "fontColor": { "type": "string" },
        "outlineColor": { "type": "string" },
        "outlineWidth": { "type": "number" },
        "shadowColor": { "type": "string" },
        "shadowBlur": { "type": "number" },
        "shadowOffsetX": { "type": "number" },
        "shadowOffsetY": { "type": "number" },
        "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 2, "default": 1.25 },
        "position": { "enum": ["top", "center"] }
      }
    },
    "cta_text": { "type": "string", "minLength": 1 },
    "cta_bg_color": { "type": "string" },
    "imagery": { "type": "string" },
    "source_provenance": { "type": "object" }
  }
}
